# LLM provider — never commit real values
# "fake" (default, no key needed) | "openai" | "azure_openai"
LLM_PROVIDER=azure_openai

# Plain OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Azure OpenAI (used when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
# Azure deployment names, if they differ from GENERATOR_MODEL/VALIDATOR_MODEL below
GENERATOR_DEPLOYMENT=
VALIDATOR_DEPLOYMENT=

# Model config — env-driven, never hardcoded in logic
GENERATOR_MODEL=gpt-4.1
VALIDATOR_MODEL=gpt-5.1
VALIDATION_THRESHOLD=60
# 1 = validate, and if it fails, spend one repair generation + re-validate.
# 0 = validate once only; a failing stage is accepted as-is and flagged
# needs_review instead of triggering a second generator call. No other values.
MAX_REPAIR_ATTEMPTS=1

# Paths
PROMPT_LIBRARY_DIR=prompts
PIPELINE_CONFIG_PATH=config/pipeline.yaml
ARTIFACT_STORE_DIR=runs

# Checkpointer
CHECKPOINT_DB_PATH=runs/checkpoints.sqlite3

# Server
HOST=0.0.0.0
PORT=8000
